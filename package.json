{
  "name": "sonda",
  "productName": "Sonda",
  "version": "0.1.0",
  "description": "Cliente de APIs local-first, sin login. Importa Swagger/OpenAPI y genera tus colecciones.",
  "main": "./out/main/index.js",
  "bin": {
    "sonda-cli": "./out/cli/sonda.cjs"
  },
  "author": "Tu Nombre",
  "homepage": "https://github.com/TU_USUARIO/sonda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TU_USUARIO/sonda.git"
  },
  "license": "MIT",
  "keywords": [
    "api-client",
    "http",
    "rest",
    "openapi",
    "swagger",
    "electron",
    "react",
    "local-first"
  ],
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:cli": "esbuild src/cli/index.ts --bundle --platform=node --target=node22 --format=cjs --banner:js=\"#!/usr/bin/env node\" --outfile=out/cli/sonda.cjs",
    "cli": "npm run build:cli --silent && node out/cli/sonda.cjs"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.8.9",
    "undici": "^8.12.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "esbuild": "^0.28.2"
  }
}
